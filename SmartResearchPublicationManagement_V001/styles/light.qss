/* ============================================================
   1. STYLE UNIFIÉ POUR TOUS LES BOUTONS
   ============================================================ */
QPushButton, QToolButton {
    font-family: "Segoe UI", "Consolas";
    font-size: 13px;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
}

/* ============================================================
   2. BOUTONS DE NAVIGATION (SIDEBAR) - ÉTAT PERSISTANT
   ============================================================ */
/* Style de base (Repos) */
QPushButton#BtnEmployee, QPushButton#BtnFinance, QPushButton#BtnPublication,
QPushButton#BtnLabs, QPushButton#BtnInventory, QPushButton#BtnPlans {
    background: transparent;
    border: 1px solid transparent;
    color: #546E7A; /* Gris-bleu pro */
    text-align: left;
}

/* État : Survol (Hover) */
QPushButton#BtnEmployee:hover, QPushButton#BtnFinance:hover, QPushButton#BtnPublication:hover,
QPushButton#BtnLabs:hover, QPushButton#BtnInventory:hover, QPushButton#BtnPlans:hover {
    background: #E0F2F1;
    color: #00796B;
}

/* ÉTAT : SÉLECTIONNÉ (C'est ici que le bouton reste "cliqué")
   Note : Active .setCheckable(True) et .setAutoExclusive(True) en Python/C++ */
QPushButton#BtnEmployee:checked, QPushButton#BtnFinance:checked,
QPushButton#BtnPublication:checked, QPushButton#BtnLabs:checked,
QPushButton#BtnInventory:checked, QPushButton#BtnPlans:checked {
    background: #00CED1; /* Cyan vibrant */
    color: white;
    border: 1px solid #00ACC1;
}

/* ============================================================
   3. BOUTONS D'ACTION INTÉRIEURS (CRUD) - COULEURS CLAIRES
   ============================================================ */

/* --- BOUTON PRIMAIRE (Ajouter, Appliquer, Sauvegarder) --- */
/* On utilise le Cyan pour l'action positive principale */
QPushButton#BtnAdd, QPushButton#BtnApply, QPushButton#BtnProdAdd,
QPushButton#BtnLabAdd, QPushButton#BtnLabsApply, QPushButton#BtnPopupSaveFinance,
QPushButton#BtnPopupSaveInv, QPushButton#BtnPopupSaveLabs, QToolButton#BtnTheme {
    background: #00CED1;
    color: white;
    border: none;
}

QPushButton#BtnAdd:hover, QPushButton#BtnApply:hover, QPushButton#BtnPopupSaveFinance:hover {
    background: #00B5B8; /* Un peu plus sombre au survol */
}

/* --- BOUTON SECONDAIRE (Editer, Export, Reset, Annuler) --- */
/* Un style neutre mais propre qui ne distrait pas l'utilisateur */
QPushButton#BtnEdit, QPushButton#BtnReset, QPushButton#BtnExport,
QPushButton#BtnProdEdit, QPushButton#BtnProdExport, QPushButton#BtnLabEdit,
QPushButton#BtnLabExport, QPushButton#BtnPopupCancelFinance,
QPushButton#BtnPopupCancelInv, QPushButton#BtnPopupResetLabs {
    background: #F1F8F9; /* Gris très clair bleuté */
    border: 1px solid #CFD8DC;
    color: #37474F;
}

QPushButton#BtnEdit:hover, QPushButton#BtnExport:hover, QPushButton#BtnPopupCancelFinance:hover {
    background: #E1F5FE;
    border: 1px solid #00CED1;
    color: #00838F;
}

/* --- BOUTON DANGER (Supprimer) --- */
/* Rouge clair pour la visibilité sans être agressif */
QPushButton#BtnDelete, QPushButton#BtnProdDelete {
    background: #FFEBEE; /* Fond rouge très pâle */
    border: 1px solid #FFCDD2;
    color: #C62828; /* Texte rouge foncé */
}

QPushButton#BtnDelete:hover, QPushButton#BtnProdDelete:hover {
    background: #FFCDD2;
    border: 1px solid #E57373;
}

/* ============================================================
   4. EFFETS DE CLIC ET ÉTATS DÉSACTIVÉS
   ============================================================ */
QPushButton:pressed {
    background: #B2EBF2;
    padding-left: 18px; /* Effet de mouvement */
}

QPushButton:disabled {
    background: #ECEFF1;
    color: #B0BEC5;
    border: 1px solid #CFD8DC;
}

/* ============================================================
   5. STRUCTURES DES PAGES (Cartes et Tableaux)
   ============================================================ */
QFrame#CardFilter, QFrame#CardTable, QFrame#CardStats {
    background: white;
    border: 1px solid #ECEFF1;
    border-radius: 15px;
}

QHeaderView::section {
    background: #F8FBFB;
    border-bottom: 2px solid #00CED1;
    padding: 6px;
    font-weight: bold;
    color: #004D40;
}
