/* ============================================================
   1. BASE DE L'APPLICATION
   ============================================================ */
QWidget#AppRoot {
    background: #f8fbfb;
    font-family: "Segoe UI", "Consolas";
    color: #2c3e50;
}

/* ============================================================
   2. SIDEBAR : DESIGN & NAVIGATION
   ============================================================ */
QFrame#Sidebar {
    background: white;
    border-right: 1px solid #e0eeee;
}

/* Style de base des boutons Sidebar */
QPushButton#BtnEmployee, QPushButton#BtnFinance, QPushButton#BtnPublication,
QPushButton#BtnLabs, QPushButton#BtnInventory, QPushButton#BtnPlans, QPushButton#BtnLogout {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 12px 15px;
    text-align: left;
    color: #7f8c8d; /* Gris pro */
    font-size: 14px;
    margin: 2px 10px;
}

/* HOVER : L'effet de survol (préparation au clic) */
QPushButton#BtnEmployee:hover, QPushButton#BtnFinance:hover,
QPushButton#BtnPublication:hover, QPushButton#BtnLabs:hover,
QPushButton#BtnInventory:hover, QPushButton#BtnPlans:hover {
    background: #e0f7f7; /* Cyan très pâle */
    color: #008b8b;
    border-left: 4px solid #00CED1; /* Petite barre de rappel à gauche */
}

/* CHECKED : L'état "Cliqué/Actif" (Reconnaissance du choix) */
/* Note: nécessite .setCheckable(True) dans ton code */
QPushButton#BtnEmployee:checked, QPushButton#BtnFinance:checked,
QPushButton#BtnPublication:checked, QPushButton#BtnLabs:checked,
QPushButton#BtnInventory:checked, QPushButton#BtnPlans:checked {
    background: #00CED1; /* Cyan plein */
    color: white;         /* Texte blanc pour le contraste */
    font-weight: bold;
    border-left: 0px;    /* On retire la barre puisque le fond est plein */
}

/* Bouton Déconnexion */
QPushButton#BtnLogout { color: #e74c3c; margin-top: 20px; }
QPushButton#BtnLogout:hover { background: #fdedec; }

/* ============================================================
   3. BOUTONS D'ACTION (CONTENU INTÉRIEUR)
   ============================================================ */
/* Boutons de validation (Identiques au choix actif Sidebar pour l'unité) */
QPushButton#BtnAdd, QPushButton#BtnApply, QPushButton#BtnProdAdd,
QPushButton#BtnLabAdd, QPushButton#BtnLabsApply, QPushButton#BtnPopupSaveFinance,
QPushButton#BtnPopupSaveInv, QPushButton#BtnPopupSaveLabs {
    background: #00CED1;
    color: white;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    border: none;
}

QPushButton#BtnAdd:hover { background: #00b5b8; }

/* Boutons Secondaires (Editer, Export, Annuler) */
QPushButton#BtnEdit, QPushButton#BtnReset, QPushButton#BtnExport,
QPushButton#BtnPopupCancelFinance, QPushButton#BtnPopupCancelInv {
    background: #ffffff;
    border: 1px solid #dbeaea;
    color: #34495e;
    border-radius: 8px;
}

QPushButton#BtnEdit:hover {
    background: #f1fafa;
    border: 1px solid #00CED1;
    color: #00CED1;
}

/* Boutons de Suppression (Clair et sécurisant) */
QPushButton#BtnDelete, QPushButton#BtnProdDelete {
    background: #fff5f5;
    border: 1px solid #ffdada;
    color: #c0392b;
    border-radius: 8px;
}

QPushButton#BtnDelete:hover { background: #fee2e2; border: 1px solid #e74c3c; }

/* ============================================================
   4. INPUTS ET CARTES
   ============================================================ */
QLineEdit, QComboBox, QDateEdit {
    background: white;
    border: 1px solid #dbeaea;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit:focus { border: 1px solid #00CED1; }

QFrame#CardFilter, QFrame#CardTable, QFrame#CardStats {
    background: white;
    border: 1px solid #eef2f2;
    border-radius: 15px;
}
