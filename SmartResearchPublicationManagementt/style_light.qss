/* ═══════════════════════════════════════════════════════════════════════════
   SmartResearchLab — LIGHT THEME "Arctic Pro"
   ═══════════════════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 13px;
    outline: none;
}

/* ── App Shell ──────────────────────────────────────────────────────────── */
QMainWindow, QWidget#centralwidget {
    background-color: #f2ebe4; /* Beige Chaud Somptueux */
}

QWidget {
    color: #1e293b;
    background-color: transparent;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QFrame#sidebarFrame {
    background: qlineargradient(x1:0.5, y1:0, x2:0.5, y2:1,
        stop:0   #f0ebe4,
        stop:0.3 #ede7e0,
        stop:0.7 #e8e2db,
        stop:1   #e0d9d0);
    border-right: 2px solid qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(31,142,149,0.85),
        stop:0.4 rgba(31,142,149,0.45),
        stop:0.8 rgba(31,142,149,0.18),
        stop:1   rgba(31,142,149,0.04));
    min-width: 220px;
    max-width: 260px;
}

QFrame#sidebarFrame QLabel {
    color: #8b6655;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 0 4px;
}

/* Nav buttons */
QFrame#sidebarFrame QPushButton {
    background: transparent;
    color: #2c3e50;
    text-align: left;
    padding: 12px 16px;
    border-radius: 12px;
    border: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    margin: 1px 6px;
}

QFrame#sidebarFrame QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(31,142,149,0.22),
        stop:0.7 rgba(31,142,149,0.08),
        stop:1   rgba(31,142,149,0.02));
    color: #073437;
    border: 1px solid rgba(31,142,149,0.35);
    border-left: 3px solid rgba(31,142,149,0.65);
    padding-left: 13px;
}

QFrame#sidebarFrame QPushButton:checked,
QFrame#sidebarFrame QPushButton[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(31,142,149,0.32),
        stop:0.5 rgba(31,142,149,0.16),
        stop:1   rgba(240,206,170,0.08));
    color: #0a3c3f;
    border: 1px solid rgba(31,142,149,0.45);
    border-left: 4px solid #1F8E95;
    padding-left: 12px;
    font-weight: 700;
    border-radius: 12px;
}

/* Boutons verrouillés */
QFrame#sidebarFrame QPushButton:disabled {
    background: transparent;
    color: rgba(100, 80, 70, 0.45);
    border: none;
    border-left: 2px solid rgba(100, 80, 70, 0.20);
    padding: 12px 16px 12px 14px;
    font-weight: 400;
    font-style: italic;
    margin: 1px 6px;
}

/* Theme toggle */
QFrame#sidebarFrame QPushButton#btnThemeToggle {
    background: rgba(31,142,149,0.08);
    color: #0f6b72;
    border: 1px solid rgba(31,142,149,0.25);
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
    padding: 10px 14px;
    margin: 2px 6px;
}
QFrame#sidebarFrame QPushButton#btnThemeToggle:hover {
    background: rgba(31,142,149,0.18);
    color: #0a4f54;
    border-color: rgba(31,142,149,0.50);
}

/* Disconnect */
QFrame#sidebarFrame QPushButton#btnDeconnecter {
    background: rgba(220,38,38,0.07);
    color: #dc2626;
    border: 1px solid rgba(220,38,38,0.22);
    border-radius: 12px;
    text-align: center;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 700;
    margin: 2px 6px;
}
QFrame#sidebarFrame QPushButton#btnDeconnecter:hover {
    background: rgba(220,38,38,0.16);
    color: #991b1b;
    border-color: rgba(220,38,38,0.50);
}

/* Barre indicatrice glissante */
QFrame#activeIndicator {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2dd4bf, stop:0.45 #1F8E95, stop:1 #0e6b72);
    border-radius: 2px;
    border: none;
}

/* ── Top bar ──────────────────────────────────────────────────────────────── */
QFrame#topBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.99),
        stop:0.5 rgba(252,250,247,0.98),
        stop:1 rgba(248,244,240,0.99));
    border-bottom: 2px solid rgba(31,142,149,0.50);
    border-top: 1px solid rgba(31,142,149,0.06);
    border-radius: 0px;
    min-height: 52px;
    max-height: 70px;
}

QFrame#topBar QLabel {
    color: #1e293b;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

/* Bouton hamburger collapse/expand sidebar */
QPushButton#btnToggleSidebar {
    background: rgba(31,142,149,0.10);
    color: #0f6b72;
    border: 1px solid rgba(31,142,149,0.28);
    border-radius: 10px;
    font-size: 17px;
    font-weight: 700;
    padding: 0;
}
QPushButton#btnToggleSidebar:hover {
    background: rgba(31,142,149,0.22);
    color: #0a4f54;
    border-color: rgba(31,142,149,0.55);
}
QPushButton#btnToggleSidebar:pressed {
    background: rgba(31,142,149,0.35);
    color: #073437;
    border-color: #1F8E95;
}

/* ── Bouton cloche notification ──────────────────────────────────────────── */
QPushButton#btnNotif {
    background: transparent;
    border: none;
    border-radius: 20px;
    font-size: 20px;
    padding: 0;
    color: #1e293b;
}
QPushButton#btnNotif:hover {
    background: rgba(31,142,149,0.12);
}
QPushButton#btnNotif:pressed {
    background: rgba(31,142,149,0.22);
}

/* ── Badge rouge ──────────────────────────────────────────────────────────── */
QLabel#notifBadge {
    background: #ef4444;
    color: #fff;
    border-radius: 9px;
    font-size: 9px;
    font-weight: 800;
    border: 1.5px solid #f5f0eb;
}

/* ── Panneau de notifications ─────────────────────────────────────────────── */
QFrame#notifPanel {
    background: #ffffff;
    border: 1px solid rgba(31,142,149,0.22);
    border-radius: 14px;
}
QWidget#notifHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(250,248,244,1.0), stop:1 rgba(242,235,228,1.0));
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}
QLabel#notifTitle {
    color: #1e293b;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
QPushButton#notifBtnAction {
    background: rgba(31,142,149,0.10);
    color: #1F8E95;
    border: 1px solid rgba(31,142,149,0.28);
    border-radius: 6px;
    font-size: 11px;
    padding: 2px 8px;
}
QPushButton#notifBtnAction:hover {
    background: rgba(31,142,149,0.22);
    color: #0a4f54;
}
QPushButton#notifBtnClear {
    background: rgba(239,68,68,0.08);
    color: #dc2626;
    border: 1px solid rgba(239,68,68,0.22);
    border-radius: 6px;
    font-size: 11px;
    padding: 2px 8px;
}
QPushButton#notifBtnClear:hover {
    background: rgba(239,68,68,0.18);
    color: #b91c1c;
}
QFrame#notifSep {
    background: rgba(31,142,149,0.15);
}
QScrollArea#notifScroll, QWidget#notifContent {
    background: transparent;
    border: none;
}
QScrollArea#notifScroll QScrollBar:vertical {
    background: rgba(31,142,149,0.06);
    width: 5px;
    border-radius: 3px;
}
QScrollArea#notifScroll QScrollBar::handle:vertical {
    background: rgba(31,142,149,0.30);
    border-radius: 3px;
}
QWidget#notifItem {
    background: transparent;
}
QWidget#notifItem:hover {
    background: rgba(31,142,149,0.04);
}
QWidget#notifItemUnread {
    background: rgba(31,142,149,0.06);
}
QWidget#notifItemUnread:hover {
    background: rgba(31,142,149,0.10);
}
QLabel#notifMsg {
    color: #1e293b;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#notifMeta {
    color: rgba(71,85,105,0.70);
    font-size: 10px;
    background: transparent;
}
QFrame#notifItemSep {
    background: rgba(0,0,0,0.05);
}
QLabel#notifEmpty {
    color: rgba(100,116,139,0.60);
    font-size: 13px;
    font-style: italic;
    background: transparent;
}

/* ── Pages / Stack ────────────────────────────────────────────────────────── */
QWidget#pageEmployee, QWidget#page_Emp, QWidget#page_add_Emp,
QWidget#pageFinance, QWidget#pageInventory, QWidget#pagePublication,
QWidget#pageLaboratoires, QWidget#pageProjets {
    background-color: transparent;
}

QStackedWidget {
    background-color: transparent;
}

/* ── General Buttons ─────────────────────────────────────────────────────── */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff,
        stop:0.5 #f6fafa,
        stop:1 #ecf7f7);
    color: #0f5a5f;
    border: 1.5px solid rgba(31,142,149,0.38);
    border-bottom: 2px solid rgba(31,142,149,0.55);
    border-radius: 10px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.2px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #d4f0f0,
        stop:0.5 #c2eaea,
        stop:1 #aee0e0);
    color: #073437;
    border-color: rgba(31,142,149,0.72);
    border-bottom-color: #1F8E95;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a0d8d8, stop:1 #8dcece);
    color: #052a2c;
    border-color: #1F8E95;
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton:disabled {
    background: rgba(241,245,249,0.70);
    color: #94a3b8;
    border-color: rgba(226,232,240,0.70);
}

/* ── Inputs ──────────────────────────────────────────────────────────────── */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox, QTimeEdit {
    background-color: #ffffff;
    color: #2c1e16;
    border: 1.5px solid #e0be9c;
    border-radius: 10px;
    padding: 7px 12px;
    selection-background-color: #f0ceaa;
    selection-color: #2c1e16;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #d1a97d;
    background-color: #ffffff;
}

QLineEdit:read-only {
    background-color: #f9f7f5;
    color: #8b6655;
}

QDateEdit:read-only {
    background-color: #f9f7f5;
    color: #8b6655;
    border-color: #e0be9c;
}
QDateEdit:read-only::drop-down { width: 0px; border: none; }

QLineEdit::placeholder { color: #c19a82; }

/* ComboBox drop-down arrow */
QComboBox::drop-down {
    border: none;
    border-left: 1px solid #cbd5e1;
    width: 28px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 6px 5px 0px 5px;
    border-color: #475569 transparent transparent transparent;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    selection-background-color: rgba(59,130,246,0.15);
    selection-color: #1e293b;
    color: #1e293b;
    padding: 4px;
    outline: none;
}

/* Spin box arrows */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: #e2e8f0;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #cbd5e1;
}

/* DateEdit calendar button */
QDateEdit::drop-down {
    border: none;
    border-left: 1px solid #cbd5e1;
    width: 28px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QDateEdit::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 6px 5px 0px 5px;
    border-color: #475569 transparent transparent transparent;
    margin-right: 6px;
}

/* ── Tables ──────────────────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f9f7f5;
    color: #2c1e16;
    border: 1px solid #e0be9c;
    border-radius: 12px;
    gridline-color: #f2ebe4;
    selection-background-color: rgba(240, 206, 170, 0.3);
    selection-color: #2c1e16;
}

QTableWidget::item, QTableView::item {
    padding: 8px 10px;
    border-bottom: 1px solid #f2ebe4;
}

QTableWidget::item:selected, QTableView::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(31,142,149,0.28),
        stop:1 rgba(31,142,149,0.10));
    color: #052a2c;
    border-left: 3px solid #1F8E95;
}

QTableWidget::item:hover, QTableView::item:hover {
    background: rgba(31,142,149,0.10);
    border-left: 2px solid rgba(31,142,149,0.30);
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #eaf5f5, stop:1 #daeeed);
    color: #0a5558;
    padding: 10px 14px;
    border: none;
    border-right: 1px solid rgba(31,142,149,0.20);
    border-bottom: 2px solid rgba(31,142,149,0.60);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 1.0px;
    text-transform: uppercase;
}

QHeaderView::section:first { border-top-left-radius: 8px; }
QHeaderView::section:last  { border-top-right-radius: 8px; }

QHeaderView { background: transparent; }
QTableCornerButton::section { background: #e2e8f0; border: none; }

/* ── Labels ──────────────────────────────────────────────────────────────── */
QLabel {
    color: #334155;
    background: transparent;
}

QLabel#lblBrand {
    color: #1F8E95;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 2px;
}

QLabel#lblPageTitle, QLabel#topTitle {
    color: #334155;
    font-size: 15px;
    font-weight: 600;
}

/* ── Scrollbars ──────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #f1f5f9;
    width: 6px;
    border-radius: 3px;
    border: none;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 28px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #f1f5f9;
    height: 6px;
    border-radius: 3px;
    border: none;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 28px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #94a3b8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── GroupBox ─────────────────────────────────────────────────────────────── */
QGroupBox {
    border: 1.5px solid rgba(31,142,149,0.32);
    border-top: 2px solid rgba(31,142,149,0.55);
    border-radius: 16px;
    margin-top: 28px;
    font-weight: 700;
    color: #0f6b72;
    padding-top: 18px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255,255,255,0.95),
        stop:1 rgba(242,250,250,0.90));
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: -9px;
    padding: 2px 10px;
    color: #0a4f54;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #e0f5f5, stop:1 #f0fafa);
    border: 1px solid rgba(31,142,149,0.35);
    border-radius: 7px;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ── Dialog / MessageBox ─────────────────────────────────────────────────── */
QDialog {
    background-color: #ffffff;
    color: #1e293b;
}

QMessageBox {
    background-color: #ffffff;
    color: #1e293b;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 7px 18px;
}

/* ── ToolButton ──────────────────────────────────────────────────────────── */
QToolButton {
    background: transparent;
    border: none;
    color: #475569;
    border-radius: 6px;
    padding: 5px;
}
QToolButton:hover {
    background: rgba(59,130,246,0.10);
    color: #1d4ed8;
}
QToolButton:pressed { background: rgba(59,130,246,0.20); }

/* ── TextEdit ─────────────────────────────────────────────────────────────── */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1e293b;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: rgba(59,130,246,0.25);
}
QTextEdit:focus, QPlainTextEdit:focus { border-color: #3b82f6; }

/* ── ProgressBar ─────────────────────────────────────────────────────────── */
QProgressBar {
    background: rgba(31,142,149,0.08);
    border: 1px solid rgba(31,142,149,0.28);
    border-radius: 8px;
    text-align: center;
    color: #0a5558;
    font-weight: 700;
    font-size: 10px;
    min-height: 10px;
    max-height: 12px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1F8E95, stop:0.6 #2dd4bf, stop:1 #45e0c5);
    border-radius: 7px;
}

/* ── CheckBox / RadioButton ──────────────────────────────────────────────── */
QCheckBox { color: #334155; spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1.5px solid #cbd5e1;
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #f0ceaa;
    border-color: #e0be9c;
}

QRadioButton { color: #334155; spacing: 8px; }
QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    background: #ffffff;
}
QRadioButton::indicator:checked {
    background: #f0ceaa;
    border-color: #e0be9c;
}

/* ── TabWidget ────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
    top: -1px;
}
QTabBar::tab {
    background: #f2ebe4;
    color: #8b6655;
    border: 1px solid #e0be9c;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 10px 22px;
    margin-right: 4px;
    font-weight: 700;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #2c1e16;
    border-bottom: 3px solid #f0ceaa;
}
QTabBar::tab:hover { 
    background: #faf7f5; 
    color: #2c1e16; 
}

/* ── Tooltip ──────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #2c1e16;
    color: #f2ebe4;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}

/* ── Frames as cards ──────────────────────────────────────────────────────── */
QFrame#card, QFrame[card="true"] {
    background: #ffffff;
    border: 1.5px solid #e0be9c;
    border-radius: 16px;
}

/* ── Menu ─────────────────────────────────────────────────────────────────── */
QMenu {
    background: #ffffff;
    border: 1px solid #e0be9c;
    border-radius: 12px;
    padding: 6px;
    color: #2c1e16;
}
QMenu::item { padding: 8px 25px; border-radius: 8px; }
QMenu::item:selected { background: #f0ceaa; color: #2c1e16; }
QMenu::separator { height: 1.5px; background: #f2ebe4; margin: 5px 10px; }

/* ── QCalendarWidget ──────────────────────────────────────────────────────── */
QCalendarWidget QWidget {
    background-color: #ffffff;
    color: #2c1e16;
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: #ffffff;
    selection-background-color: #f0ceaa;
    selection-color: #2c1e16;
}
QCalendarWidget QToolButton {
    background-color: #f9f7f5;
    color: #2c1e16;
    border-radius: 4px;
}
QCalendarWidget QMenu {
    background-color: #ffffff;
    color: #2c1e16;
}
QCalendarWidget QSpinBox {
    background-color: #ffffff;
}
