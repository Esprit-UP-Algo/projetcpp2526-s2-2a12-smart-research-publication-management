/* ═══════════════════════════════════════════════════════════════════════════
   SmartResearchLab — DARK THEME "Midnight Teal"
   ═══════════════════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 13px;
    outline: none;
}

/* ── App Shell ──────────────────────────────────────────────────────────── */
QMainWindow, QWidget#centralwidget {
    background-color: #0f172a;
}

QWidget {
    color: #e2e8f0;
    background-color: transparent;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QFrame#sidebarFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0f172a, stop:1 #091526);
    border-right: 1px solid #1e3a5f;
    min-width: 220px;
    max-width: 260px;
}

QFrame#sidebarFrame QLabel {
    color: rgba(255,255,255,0.45);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 0 4px;
}

/* Nav buttons */
QFrame#sidebarFrame QPushButton {
    background: transparent;
    color: rgba(148,197,230,0.80);
    text-align: left;
    padding: 11px 14px;
    border-radius: 10px;
    border: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

QFrame#sidebarFrame QPushButton:hover {
    background: rgba(14,165,233,0.10);
    color: #e2e8f0;
}

QFrame#sidebarFrame QPushButton:checked,
QFrame#sidebarFrame QPushButton[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(14,165,233, 0.22), stop:1 rgba(31,142,149, 0.18));
    color: #38bdf8;
    border-left: 3px solid #0ea5e9;
    padding-left: 11px;
    font-weight: 700;
}

/* Theme toggle button — special styling */
QFrame#sidebarFrame QPushButton#btnThemeToggle {
    background: rgba(31,142,149, 0.08);
    color: #7fb3d3;
    border: 1px solid rgba(31,142,149, 0.20);
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    padding: 9px 14px;
}
QFrame#sidebarFrame QPushButton#btnThemeToggle:hover {
    background: rgba(31,142,149, 0.18);
    color: #38bdf8;
    border-color: rgba(31,142,149, 0.45);
}

/* Disconnect button */
QFrame#sidebarFrame QPushButton#btnDeconnecter {
    background: rgba(239,68,68,0.08);
    color: #f87171;
    border: 1px solid rgba(239,68,68,0.20);
    border-radius: 10px;
    text-align: center;
    padding: 9px 14px;
    font-size: 12px;
    font-weight: 600;
}
QFrame#sidebarFrame QPushButton#btnDeconnecter:hover {
    background: rgba(239,68,68,0.20);
    color: #fca5a5;
    border-color: rgba(239,68,68,0.45);
}

/* ── Top bar ──────────────────────────────────────────────────────────────── */
QFrame#topBar {
    background: rgba(13,31,56,0.60);
    border-bottom: 1px solid #1e3a5f;
    min-height: 52px;
    max-height: 60px;
}

QFrame#topBar QLabel {
    color: #e2e8f0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

/* ── Pages / Stack ────────────────────────────────────────────────────────── */
QWidget#pageEmployee, QWidget#page_Emp, QWidget#page_add_Emp,
QWidget#pageFinance, QWidget#pageInventory, QWidget#pagePublication,
QWidget#pageLaboratoires, QWidget#pageProjets {
    background-color: #0f172a;
}

QStackedWidget {
    background-color: #0f172a;
}

/* ── General Buttons ─────────────────────────────────────────────────────── */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1e3a5f, stop:1 #162d4a);
    color: #93c5fd;
    border: 1px solid #2d5a8e;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2d5a8e, stop:1 #1e3a5f);
    color: #bfdbfe;
    border-color: #4a90d9;
}

QPushButton:pressed {
    background: #0d1f38;
    color: #60a5fa;
}

QPushButton:disabled {
    background: #0d1f38;
    color: #334155;
    border-color: #1e3a5f;
}

/* ── Inputs ──────────────────────────────────────────────────────────────── */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox, QTimeEdit {
    background-color: #0d1f38;
    color: #e2e8f0;
    border: 1.5px solid #1e3a5f;
    border-radius: 8px;
    padding: 7px 12px;
    selection-background-color: #0ea5e9;
    selection-color: white;
    min-height: 16px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0ea5e9;
    background-color: #0f2540;
}

QLineEdit:read-only {
    background-color: #091526;
    color: #64748b;
}

QLineEdit::placeholder { color: #2d5a8e; }

/* ComboBox drop-down arrow */
QComboBox::drop-down {
    border: none;
    border-left: 1px solid #1e3a5f;
    width: 28px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 6px 5px 0px 5px;
    border-color: #e2e8f0 transparent transparent transparent;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #0d1f38;
    border: 1px solid #1e3a5f;
    border-radius: 8px;
    selection-background-color: rgba(14,165,233,0.25);
    selection-color: #e2e8f0;
    color: #e2e8f0;
    padding: 4px;
    outline: none;
}

/* Spin box arrows */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: #1e3a5f;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #2d5a8e;
}

/* DateEdit calendar button */
QDateEdit::drop-down {
    border: none;
    border-left: 1px solid #1e3a5f;
    width: 28px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QDateEdit::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 6px 5px 0px 5px;
    border-color: #e2e8f0 transparent transparent transparent;
    margin-right: 6px;
}

/* ── Tables ──────────────────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #0d1f38;
    alternate-background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #1e3a5f;
    border-radius: 10px;
    gridline-color: #1e3a5f;
    selection-background-color: rgba(14,165,233, 0.20);
    selection-color: #e2e8f0;
    padding: 2px;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1e3a5f;
}

QTableWidget::item:selected, QTableView::item:selected {
    background: rgba(14,165,233, 0.22);
    color: #e2e8f0;
}

QTableWidget::item:hover, QTableView::item:hover {
    background: rgba(14,165,233, 0.10);
}

QHeaderView::section {
    background-color: #0d1f38;
    color: #7fb3d3;
    padding: 10px 10px;
    border: none;
    border-right: 1px solid #0f172a;
    border-bottom: 2px solid #0ea5e9;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QHeaderView::section:first { border-top-left-radius: 8px; }
QHeaderView::section:last  { border-top-right-radius: 8px; }

QHeaderView { background: transparent; }
QTableCornerButton::section { background: #0d1f38; border: none; }

/* ── Labels ──────────────────────────────────────────────────────────────── */
QLabel {
    color: #7fb3d3;
    background: transparent;
}

QLabel#lblBrand {
    color: #38bdf8;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

QLabel#lblPageTitle, QLabel#topTitle {
    color: #38bdf8;
    font-size: 15px;
    font-weight: 600;
}

/* ── Scrollbars ──────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #091526;
    width: 6px;
    border-radius: 3px;
    border: none;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1e3a5f;
    min-height: 28px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #2d5a8e; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #091526;
    height: 6px;
    border-radius: 3px;
    border: none;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #1e3a5f;
    min-width: 28px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #2d5a8e; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── GroupBox ─────────────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #1e3a5f;
    border-radius: 10px;
    margin-top: 24px;
    font-weight: 700;
    color: #7fb3d3;
    padding-top: 14px;
    background: #0d1f38;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: -7px;
    padding: 0 7px;
    color: #38bdf8;
    background: #0d1f38;
}

/* ── Dialog / MessageBox ─────────────────────────────────────────────────── */
QDialog {
    background-color: #0d1f38;
    color: #e2e8f0;
}

QMessageBox {
    background-color: #0d1f38;
    color: #e2e8f0;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 7px 18px;
}

/* ── ToolButton ──────────────────────────────────────────────────────────── */
QToolButton {
    background: transparent;
    border: none;
    color: #7fb3d3;
    border-radius: 6px;
    padding: 5px;
}
QToolButton:hover {
    background: rgba(14,165,233,0.14);
    color: #38bdf8;
}
QToolButton:pressed { background: rgba(14,165,233,0.25); }

/* ── TextEdit ─────────────────────────────────────────────────────────────── */
QTextEdit, QPlainTextEdit {
    background-color: #0d1f38;
    color: #e2e8f0;
    border: 1.5px solid #1e3a5f;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: rgba(14,165,233,0.35);
}
QTextEdit:focus, QPlainTextEdit:focus { border-color: #0ea5e9; }

/* ── ProgressBar ─────────────────────────────────────────────────────────── */
QProgressBar {
    background: #0d1f38;
    border: 1px solid #1e3a5f;
    border-radius: 6px;
    text-align: center;
    color: #94a3b8;
    font-weight: 600;
    font-size: 10px;
    min-height: 8px;
    max-height: 10px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0ea5e9, stop:1 #1F8E95);
    border-radius: 5px;
}

/* ── CheckBox / RadioButton ──────────────────────────────────────────────── */
QCheckBox { color: #cbd5e1; spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1.5px solid #2d5a8e;
    border-radius: 4px;
    background: #0d1f38;
}
QCheckBox::indicator:checked {
    background: #0ea5e9;
    border-color: #0ea5e9;
}

QRadioButton { color: #cbd5e1; spacing: 8px; }
QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1.5px solid #2d5a8e;
    border-radius: 8px;
    background: #0d1f38;
}
QRadioButton::indicator:checked {
    background: #0ea5e9;
    border-color: #0ea5e9;
}

/* ── TabWidget ────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #1e3a5f;
    border-radius: 8px;
    background: #0d1f38;
    top: -1px;
}
QTabBar::tab {
    background: #091526;
    color: #64748b;
    border: 1px solid #1e3a5f;
    border-bottom: none;
    border-radius: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 8px 18px;
    margin-right: 2px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #0d1f38;
    color: #38bdf8;
    border-bottom: 2px solid #0ea5e9;
}
QTabBar::tab:hover { background: #0f2540; color: #93c5fd; }

/* ── Tooltip ──────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1e3a5f;
    color: #e2e8f0;
    border: 1px solid #2d5a8e;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 11px;
}

/* ── Frames as cards ──────────────────────────────────────────────────────── */
QFrame#card, QFrame[card="true"] {
    background: #0d1f38;
    border: 1px solid #1e3a5f;
    border-radius: 12px;
}

/* ── Menu ─────────────────────────────────────────────────────────────────── */
QMenu {
    background: #0d1f38;
    border: 1px solid #1e3a5f;
    border-radius: 8px;
    padding: 4px;
    color: #e2e8f0;
}
QMenu::item { padding: 7px 20px; border-radius: 5px; }
QMenu::item:selected { background: rgba(14,165,233,0.20); color: #38bdf8; }
QMenu::separator { height: 1px; background: #1e3a5f; margin: 4px 8px; }

/* ── QCalendarWidget ──────────────────────────────────────────────────────── */
QCalendarWidget QWidget {
    background-color: #0d1f38;
    color: #e2e8f0;
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: #0d1f38;
    selection-background-color: rgba(14,165,233,0.3);
    selection-color: #ffffff;
}
QCalendarWidget QToolButton {
    background-color: #1e3a5f;
    color: #e2e8f0;
    border-radius: 4px;
}
QCalendarWidget QMenu {
    background-color: #0d1f38;
    color: #e2e8f0;
}
QCalendarWidget QSpinBox {
    background-color: #0d1f38;
}
